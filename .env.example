# Supabase
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PostHog analytics (optional — analytics is disabled when unset).
# Only the public project key belongs here; never a personal/private API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile (optional — CAPTCHA is disabled when unset).
# Public site key only. The secret key goes in Supabase's auth CAPTCHA config,
# and Supabase CAPTCHA protection must be enabled there for this to take effect.
VITE_TURNSTILE_SITE_KEY=
